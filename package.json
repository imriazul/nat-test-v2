{
  "name": "nat-test-v2",
  "version": "2.0.0",
  "description": "NAT-TEST BD CBT Seat Availability and Registration System",
  "private": true,
  "scripts": {
    "dev": "npm run watch",
    "watch": "tailwindcss -i ./assets/css/input.css -o ./assets/css/style.min.css --watch",
    "watch:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/style.min.css --watch",
    "build": "tailwindcss -i ./assets/css/input.css -o ./assets/css/style.min.css --minify",
    "build:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/style.min.css --minify",
    "build:prod": "NODE_ENV=production tailwindcss -i ./assets/css/input.css -o ./assets/css/style.min.css --minify"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15"
  }
}

